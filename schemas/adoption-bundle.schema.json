{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordpress-hx.dev/schemas/adoption-bundle.schema.json",
  "title": "WordPressHx immutable adoption content bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "bundleId",
    "bundleVersion",
    "provider",
    "members",
    "bundleDigest"
  ],
  "properties": {
    "schema": {
      "const": "wordpress-hx.adoption-bundle.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "bundleId": {
      "$ref": "#/$defs/id"
    },
    "bundleVersion": {
      "$ref": "#/$defs/semver"
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/member"
      }
    },
    "bundleDigest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*?/\\.{1,2}(?:/|$))[A-Za-z0-9._@+-]+(?:/[A-Za-z0-9._@+-]+)*$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "artifactSha256"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "sizeBytes"],
      "properties": {
        "role": {
          "enum": [
            "capability",
            "contract",
            "haxe-facade",
            "javascript-facade",
            "php-facade",
            "provider-artifact",
            "review"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
