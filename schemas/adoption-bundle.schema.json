{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordpress-hx.dev/schemas/adoption-bundle.schema.json",
  "title": "WordPressHx immutable adoption bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "bundleId",
    "bundleVersion",
    "provider",
    "records",
    "generatedFiles",
    "bundleDigest"
  ],
  "properties": {
    "schema": {
      "const": "wordpress-hx.adoption-bundle.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "bundleId": {
      "$ref": "#/$defs/id"
    },
    "bundleVersion": {
      "$ref": "#/$defs/semver"
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "records": {
      "$ref": "#/$defs/records"
    },
    "generatedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "bundleDigest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[^/][^\\\\]*$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "artifactSha256"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "ownershipRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "manifestDigest"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifestDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "capability", "review", "ownership"],
      "properties": {
        "contract": {
          "$ref": "#/$defs/record"
        },
        "capability": {
          "$ref": "#/$defs/record"
        },
        "review": {
          "$ref": "#/$defs/record"
        },
        "ownership": {
          "$ref": "#/$defs/ownershipRecord"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
