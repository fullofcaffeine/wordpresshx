{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordpresshx.dev/schemas/unsafe-boundary-review.schema.json",
  "title": "WordPressHx unsafe-boundary independent review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "simulationOnly",
    "waiverId",
    "waiverSubjectSha256",
    "reviewer",
    "reviewedAt",
    "prompt",
    "inputs",
    "repositorySnapshotSha256",
    "source",
    "evidence",
    "findings",
    "decision",
    "independence",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "receiptId": {
      "type": "string",
      "pattern": "^WPHX-UNSAFE-REVIEW-[0-9]{4}-[0-9]{2}$"
    },
    "simulationOnly": {"type": "boolean"},
    "waiverId": {"$ref": "#/$defs/waiverId"},
    "waiverSubjectSha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "provider", "model", "role"],
      "properties": {
        "identity": {"$ref": "#/$defs/nonEmpty"},
        "provider": {"$ref": "#/$defs/nonEmpty"},
        "model": {"$ref": "#/$defs/nonEmpty"},
        "role": {"const": "independent-security-reviewer"}
      }
    },
    "reviewedAt": {"$ref": "#/$defs/utcInstant"},
    "prompt": {"$ref": "#/$defs/fileDigest"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileDigest"}
    },
    "repositorySnapshotSha256": {"$ref": "#/$defs/sha256"},
    "source": {"$ref": "#/$defs/fileDigest"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileDigest"}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "summary", "disposition"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WPHX-UNSAFE-F[0-9]{3}$"
          },
          "severity": {
            "enum": ["informational", "low", "medium", "high", "critical"]
          },
          "summary": {"$ref": "#/$defs/nonEmpty"},
          "disposition": {"enum": ["accepted-risk", "resolved"]}
        }
      }
    },
    "decision": {"const": "approved"},
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerDiffersFromOwner",
        "contextIsolated",
        "reviewerAuthoredWaiver"
      ],
      "properties": {
        "reviewerDiffersFromOwner": {"const": true},
        "contextIsolated": {"const": true},
        "reviewerAuthoredWaiver": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonEmpty"}
    }
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "waiverId": {
      "type": "string",
      "pattern": "^WPHX-UNSAFE-[0-9]{4}$"
    },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
