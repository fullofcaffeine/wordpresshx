{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordpresshx.dev/schemas/unsafe-boundary-bead-status.schema.json",
  "title": "WordPressHx unsafe-boundary removal Bead status receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "source",
    "observedAt",
    "issue",
    "projectionSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "receiptId": {
      "type": "string",
      "pattern": "^WPHX-BEAD-STATUS-[A-Z0-9-]+$"
    },
    "source": {"const": "bd-show-after-dolt-pull"},
    "observedAt": {"$ref": "#/$defs/utcInstant"},
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "updatedAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^wordpresshx-[a-z0-9.-]+$"
        },
        "status": {"enum": ["open", "in_progress"]},
        "updatedAt": {"$ref": "#/$defs/utcInstant"}
      }
    },
    "projectionSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utcInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
