    },
    {
      "id": "unchecked-external-contract",
      "detectors": ["adoption-contract-validator", "provider-contract-scan"],
      "allowedScopes": ["experimental-opt-in", "generated-interop-internal"],
      "waiverRequired": true,
      "decoderEvidenceRequired": true,
      "stableWithCurrentWaiverAllowed": false,
      "independentSecurityReviewRequired": true
    }
