-cp src
-cp test/compiler-tracer/negative/unsupported-value/src
-lib reflaxe:4.0.0-beta
-main tracer.Main
-D reflaxe_php_output=build/compiler-tracer-negative
-D reflaxe_php_profile=php74-modern-v1
-D reflaxe_php_source_root=test/compiler-tracer/negative/unsupported-value/src
--macro reflaxe.php.compiler.CompilerInit.Start()
