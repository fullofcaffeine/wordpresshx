-cp src
-cp test/semantic-matrix/negative/string-coercion/src
-lib reflaxe:4.0.0-beta
-main semantics.Main
-D reflaxe_php_output=build/semantic-matrix-negative-string-coercion
-D reflaxe_php_profile=php74-modern-v1
-D reflaxe_php_source_root=test/semantic-matrix/negative/string-coercion/src
--macro reflaxe.php.compiler.CompilerInit.Start()
