-cp src
-cp test/semantic-matrix/negative/overflow-int-multiplication/src
-lib reflaxe:4.0.0-beta
-main semantics.Main
-D reflaxe_php_output=build/semantic-matrix-negative-overflow-int-multiplication
-D reflaxe_php_profile=php74-modern-v1
